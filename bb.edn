{:paths ["src"]
 :bbin/bin {lume {:main-opts ["-m" "lume.cli"]}}
 :tasks {test {:doc "Run every test/**/*_test.clj namespace"
               :extra-paths ["test"]
               :requires ([lume.runner :as r])
               :task (let [{:keys [fail error]} (r/run-all "test")]
                       (when (pos? (+ fail error)) (System/exit 1)))}}}
