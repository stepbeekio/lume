{:paths ["src"]
 :bbin/bin {lume {:main-opts ["-m" "lume.cli"]}}
 :tasks {test {:doc "Run the test suite"
               :extra-paths ["test"]
               :requires ([lume.runner :as r] [lume.kernel-test])
               :task (let [{:keys [fail error]} (r/run-tests 'lume.kernel-test)]
                       (when (pos? (+ fail error)) (System/exit 1)))}}}
